FROM ghcr.io/astral-sh/uv:0.9.10 AS uv

FROM python:3.12-slim-bookworm

COPY --from=uv /uv /uvx /bin/

ENV PATH="/opt/mlflow/.venv/bin:${PATH}" \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

RUN groupadd --gid 10001 mlflow \
    && useradd --uid 10001 --gid mlflow --no-create-home --shell /usr/sbin/nologin mlflow \
    && mkdir -p /opt/mlflow \
    && chown mlflow:mlflow /opt/mlflow

WORKDIR /opt/mlflow

COPY pyproject.toml uv.lock README.md ./
RUN uv sync \
    --frozen \
    --no-install-project \
    --only-group mlflow-server

COPY deploy/mlflow/start-mlflow-server.sh /usr/local/bin/start-mlflow-server
RUN chmod 0555 /usr/local/bin/start-mlflow-server

USER 10001:10001

EXPOSE 5000

ENTRYPOINT ["/usr/local/bin/start-mlflow-server"]
