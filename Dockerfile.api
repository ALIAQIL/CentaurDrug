FROM python:3.12-slim

WORKDIR /app

ENV UV_SYSTEM_PYTHON=1
ENV CENTAURDRUG_MODEL_ROOT=/app/models/admet_xgboost
ENV CENTAURDRUG_ALLOWED_MODEL_ROOTS=/app/models/admet_xgboost
ENV CENTAURDRUG_REQUIRE_MODELS_ON_STARTUP=1

COPY pyproject.toml ./
RUN pip install --no-cache-dir uv && uv sync --no-dev

COPY . .

EXPOSE 8000
VOLUME ["/app/models/admet_xgboost"]

CMD ["uv", "run", "uvicorn", "src.api.main:app", "--host", "0.0.0.0", "--port", "8000"]
