FROM ghcr.io/astral-sh/uv:0.9.10 AS uv

FROM apache/airflow:3.2.2-python3.12

COPY --from=uv /uv /uvx /bin/

USER root
RUN mkdir -p /opt/airflow/centaurdrug \
    && chown -R airflow:0 /opt/airflow/centaurdrug

USER airflow
WORKDIR /opt/airflow/centaurdrug

COPY --chown=airflow:0 pyproject.toml uv.lock README.md ./
RUN uv sync \
    --frozen \
    --no-dev \
    --group training \
    --group mlops \
    --group orchestration \
    --no-install-project

COPY --chown=airflow:0 src ./src
COPY --chown=airflow:0 configs ./configs
COPY --chown=airflow:0 data ./data
COPY --chown=airflow:0 .dvc ./.dvc
COPY --chown=airflow:0 dvc.yaml dvc.lock ./
COPY --chown=airflow:0 dags /opt/airflow/dags

RUN mkdir -p \
        /opt/airflow/persistent/models \
        /opt/airflow/persistent/model-bundles \
        /opt/airflow/persistent/dvc-cache \
    && ln -s /opt/airflow/persistent/models models \
    && ln -s /opt/airflow/persistent/model-bundles model_bundles \
    && ln -s /opt/airflow/persistent/dvc-cache .dvc/cache

ENV CENTAURDRUG_PROJECT_ROOT=/opt/airflow/centaurdrug \
    PYTHONPATH=/opt/airflow/centaurdrug \
    PATH="/opt/airflow/centaurdrug/.venv/bin:${PATH}"
